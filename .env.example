# CivicWorkOS has no required runtime secrets: it is a library +
# scripts, not a hosted service, and the paper names no external API,
# database, or credentialed dependency (see docs/paper_implementation_mapping.md).
# This file exists for the settings a deployment MIGHT need to override;
# copy it to .env and adjust as needed. Never commit a real .env file.

# Optional: override the MIP solver's default time limit (seconds), read
# by civicworkos.solver.rebalance._default_time_limit_seconds(). Eq. 16
# is NP-hard with no problem-size guidance from the paper (report
# Sec. 8.1); this bounds a rebalance's worst-case wall-clock time.
CIVICWORKOS_SOLVER_TIME_LIMIT_SECONDS=60
